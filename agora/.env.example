# Copy to .env before `docker compose up`. Never commit the real file.

# This deployment's identity. Stamped on every fact and every API key; two
# teams must not share one.
AGORA_DEPLOYMENT_ID=team-alpha

# Database credentials. The database is not published to the host.
POSTGRES_DB=agora
POSTGRES_USER=agora
POSTGRES_PASSWORD=change-me

# Where the server listens on the host. Loopback by default — put a TLS
# terminator in front before exposing it to a network. API keys are bearer
# tokens: over plain HTTP anyone on the path can replay them.
AGORA_BIND=127.0.0.1:8000

AGORA_LOG_LEVEL=info
